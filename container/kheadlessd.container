[Unit]
Description=Containerized KHeadless coordinator
After=graphical-session.target
PartOf=graphical-session.target

[Container]
Image=localhost/kheadless:local
ContainerName=kheadlessd
Network=host
User=%U
Group=%G
ReadOnly=true
NoNewPrivileges=true
DropCapability=all
Environment=XDG_RUNTIME_DIR=%t
Environment=WAYLAND_DISPLAY=wayland-0
Environment=PIPEWIRE_REMOTE=pipewire-0
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus
Environment=XDG_CONFIG_HOME=/var/lib/kheadless/config
Environment=XDG_DATA_HOME=/var/lib/kheadless/data
Volume=%t/wayland-0:%t/wayland-0
Volume=%t/pipewire-0:%t/pipewire-0
Volume=%t/bus:%t/bus
Volume=%h/.local/state/kheadless:/var/lib/kheadless
Tmpfs=/tmp:size=64m,mode=1777

[Service]
Restart=on-failure

[Install]
WantedBy=graphical-session.target
