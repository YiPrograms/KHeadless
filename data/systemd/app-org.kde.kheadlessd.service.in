[Unit]
Description=KHeadless Plasma RDP coordinator
Documentation=file:@CMAKE_INSTALL_FULL_DOCDIR@/README.md
After=plasma-core.target plasma-xdg-desktop-portal-kde.service pipewire.service
PartOf=graphical-session.target

[Service]
Type=dbus
BusName=org.kde.KHeadless1
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/kheadlessd
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
RuntimeDirectory=krdp
ReadWritePaths=%h/.config %h/.local/share
ReadWritePaths=%t/krdp

[Install]
WantedBy=plasma-workspace.target
