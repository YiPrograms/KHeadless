#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-2.0-or-later
set -euo pipefail

if [[ "$#" -gt 2 ]]; then
    printf 'Usage: %s [version] [output-directory]\n' "$0" >&2
    exit 2
fi

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
version="${1:-$(sed -n 's/^project(KHeadless VERSION \([^ ]*\).*/\1/p' "$project_root/CMakeLists.txt")}"
output_directory="${2:-$project_root/dist}"
archive_name="KHeadless-${version}"
work_directory="$(mktemp -d)"
trap 'rm -rf "$work_directory"' EXIT

mkdir -p "$output_directory"
git -C "$project_root" archive --format=tar --prefix="$archive_name/" HEAD \
    | tar -xf - -C "$work_directory"
git -C "$project_root/third_party/krdp" archive \
    --format=tar --prefix="$archive_name/third_party/krdp/" HEAD \
    | tar -xf - -C "$work_directory"

source_date_epoch="$(git -C "$project_root" log -1 --format=%ct)"
tar -C "$work_directory" \
    --sort=name \
    --mtime="@$source_date_epoch" \
    --owner=0 \
    --group=0 \
    --numeric-owner \
    -cf - "$archive_name" \
    | gzip -n > "$output_directory/$archive_name.tar.gz"

printf '%s\n' "$output_directory/$archive_name.tar.gz"
